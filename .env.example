# ==============================================================================
# MemCore — Environment Configuration
# ==============================================================================

# PostgreSQL with pgvector
DATABASE_URL=postgresql://memcore_user:memcore_secret@localhost:5432/memcore
POSTGRES_DB=memcore
POSTGRES_USER=memcore_user
POSTGRES_PASSWORD=memcore_secret
POSTGRES_PORT=5432

# Redis Cache & Working Memory Buffer
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Celery Sleep-Time Compute Daemon
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_INACTIVITY_SLEEP_COUNTDOWN=300

# LLM Providers (LiteLLM / Groq / OpenAI compatible)
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=groq/llama-3.3-70b-versatile

# Memory Architecture Parameters
FAST_PATH_TOKEN_BUDGET=2000
WORKING_MEMORY_WINDOW_SIZE=6
EMBEDDING_DIM=384
DEFAULT_USER_ID=default_user
